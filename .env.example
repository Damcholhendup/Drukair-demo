# ---------------------------------------------------------------------------
# Bhutan NDI credentials — TEMPLATE ONLY.
#
# This file IS committed. Never put real values here.
# Put them in `.env.local`, which is gitignored.
#
# All of these are read on the server only. None are NEXT_PUBLIC_*, so they
# are never sent to the browser.
# ---------------------------------------------------------------------------

# From the Bhutan NDI team.
NDI_CLIENT_ID=
NDI_CLIENT_SECRET=

# Hosts. Auth and the service APIs live on different hosts.
NDI_AUTH_BASE_URL=https://staging.bhutanndi.com
NDI_CLIENT_BASE_URL=https://demo-client.bhutanndi.com

# Schema whose attributes we ask the holder to PRESENT at check-in (the proof).
NDI_FOUNDATIONAL_SCHEMA_URL=https://dev-schema.ngotag.com/schemas/c7952a0a-e9b5-4a4b-a714-1e5d0a1ae076

# Schema of the credential we ISSUE once check-in succeeds.
# The attribute names in lib/ndi/records.ts (CIF, Bank Name) must match this
# schema exactly — NDI matches them literally.
NDI_ISSUANCE_SCHEMA_URL=https://dev-schema.ngotag.com/schemas/61179c5f-44f4-4380-ae37-ff3b1f093288

# Optional. The documented /authentication call needs no bearer token, but the
# sample curl carried one. If your gateway requires it, set it here and it will
# be sent on the auth request.
NDI_AUTH_BEARER=

# ---------------------------------------------------------------------------
# Webhook
#
# Registration is a one-time, manual step done directly against NDI (not by
# this app) — it needs a stable public URL for /webhook, which a throwaway dev
# tunnel isn't. Once registered (OAuth2 "v2"), put the same two values here:
# ---------------------------------------------------------------------------

# The webhookId that was registered with NDI.
NDI_WEBHOOK_ID=

# The fixed token NDI echoes back in the Authorization header — must be
# EXACTLY what was used at registration. This is the only thing preventing a
# forged "proof validated" callback from reaching /webhook.
NDI_WEBHOOK_AUTH_TOKEN=

# Optional tuning.
# NDI_PROOF_TTL_MS=300000      # how long a QR stays valid (default 5 min)
# NDI_SESSION_TTL_MS=3600000   # when sessions (and their PII) are purged
